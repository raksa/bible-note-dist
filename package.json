{
  "name": "bible-note",
  "version": "0.6.0",
  "description": "A Bible study tool for taking notes and organizing your thoughts.",
  "license": "MIT",
  "author": "raksa <eng.raksa@gmail.com>",
  "homepage": "https://github.com/raksa/bible-note-dist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raksa/bible-note-dist.git"
  },
  "bugs": {
    "url": "https://github.com/raksa/bible-note-dist/issues"
  },
  "type": "module",
  "main": "./dist/bible-note.cjs",
  "module": "./dist/bible-note.mjs",
  "types": "./types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./types/lib.d.ts",
      "import": "./dist/bible-note.mjs",
      "require": "./dist/bible-note.cjs"
    },
    "./styles.css": "./dist/bible-note.css",
    "./knowledge/development.md": "./knowledge/development.md",
    "./knowledge/ui-rag.md": "./knowledge/ui-rag.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "knowledge",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "bible",
    "lexical",
    "editor",
    "react",
    "notes"
  ]
}